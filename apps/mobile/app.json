{
  "expo": {
    "name": "Season Challenger",
    "slug": "season-challenger",
    "scheme": "seasonchallenger",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Season Challenger needs your photos so you can add pictures of your ID card or passport for the ID check.",
          "cameraPermission": "Season Challenger uses the camera to photograph your ID card or passport for the ID check.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.seasonchallenger.app"
    },
    "android": {
      "package": "com.seasonchallenger.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
