# API
PORT=3000
# Leave unset to keep everything in memory for development. Required in production.
# DATABASE_URL=postgres://season:season@localhost:5432/season_challenger
# How often the worker syncs the feed, in seconds.
WORKER_SECONDS=60
REDIS_URL=redis://localhost:6379
# Which football data source the API uses: "fake" (offline, deterministic) or a real provider later.
FOOTBALL_FEED=fake
# "dev" also accepts an x-user-id header as sign-in, for tests and scripts. Production ignores it.
AUTH_MODE=dev
# Key for hashing sign-in codes; production needs a random value of 32+ characters.
AUTH_SECRET=
# Google sign-in: the OAuth *Web* client id from Google Cloud (not a secret). Leave unset to turn it off.
# GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Who sends sign-in codes. "console" prints them in the API log; production needs a real provider.
# "sslwireless" sends through SSL Wireless SMS Plus with the token and sender id from their panel.
SMS_PROVIDER=console
# SSLWIRELESS_API_TOKEN=
# SSLWIRELESS_SID=
# SSLWIRELESS_URL=https://smsplus.sslwireless.com
# Set to true behind a proxy or load balancer, so sign-in rate limits see client addresses.
# TRUST_PROXY=true
# Key for hashing ID document numbers; production needs a random value of 32+ characters.
ID_HASH_SECRET=dev-only-secret
# ID check (docs/KYC.md). Base64 of 32 random bytes (openssl rand -base64 32); encrypts ID photos.
# Required in production; development uses a fixed dev key.
# KYC_ENCRYPTION_KEY=
# Directory for the encrypted ID photos. Unset in development keeps them in memory.
# KYC_STORAGE_DIR=./data/kyc
# Token for the ID review page at http://localhost:3000/review. Unset turns review off.
# KYC_REVIEWER_TOKEN=
# Days after the decision before ID photos are deleted.
# KYC_RETENTION_DAYS=90

# Mobile (Expo reads EXPO_PUBLIC_* at build time)
# Where the app reaches the API. On a phone, use your computer's LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
