# API
PORT=3000
# Leave unset to keep everything in memory for development. Required in production.
# DATABASE_URL=postgres://season:season@localhost:5432/season_challenger
# How often the worker syncs the feed, in seconds.
WORKER_SECONDS=60
REDIS_URL=redis://localhost:6379
# Which football data source the API uses: "fake" (offline, deterministic) or a real provider later.
FOOTBALL_FEED=fake
# "dev" also accepts an x-user-id header as sign-in, for tests and scripts. Production ignores it.
AUTH_MODE=dev
# Key for hashing sign-in codes; production needs a random value of 32+ characters.
AUTH_SECRET=
# Who sends sign-in codes. "console" prints them in the API log; production needs a real provider.
# "sslwireless" sends through SSL Wireless SMS Plus with the token and sender id from their panel.
SMS_PROVIDER=console
# SSLWIRELESS_API_TOKEN=
# SSLWIRELESS_SID=
# SSLWIRELESS_URL=https://smsplus.sslwireless.com
# Set to true behind a proxy or load balancer, so sign-in rates see client addresses.
# TRUST_PROXY=true
# ---------------------------------------------------------------- money (Game of 11 flows)
# Set to false for a coin-only economy with no deposits, conversions or withdrawals.
# MONEY_ENABLED=true
# "mock" runs a development checkout page on this API. Real bKash/Nagad/Rocket/Upay adapters
# gateways plug into the same PaymentGateway interface.
# PAYMENTS_GATEWAY=mock
# Secret the gateway signs webhook bodies with; falls back to AUTH_SECRET.
# PAYMENTS_SECRET=
# Absolute URL of this API, used to build payment links the app can open.
# API_PUBLIC_URL=http://localhost:3000
# Rates and limits, mirroring Game of 11's settings (50 coins per taka, 20 taka minimum buy,
# 500-10000 taka cash-outs). Converting won coins to cash costs more coins per taka than
# buying, by design, so deposits stay entry money.
# MONEY_COINS_PER_BDT=50
# MONEY_MIN_DEPOSIT_BDT=20
# MONEY_MAX_DEPOSIT_BDT=25000
# MONEY_MIN_REDEEM_BDT=1
# MONEY_COIN_TO_CASH_COINS_PER_BDT=60
# MONEY_MIN_CONVERSION_BDT=10
# MONEY_MIN_WITHDRAW_BDT=500
# MONEY_MAX_WITHDRAW_BDT=10000
# Token the payout review queue expects in the x-admin-token header; 32+ random chars in
# production.
# ADMIN_TOKEN=
# Key for hashing ID document numbers; set a long random value outside development.
ID_HASH_SECRET=dev-only-secret

# Mobile (Expo reads EXPO_PUBLIC_* at build time)
# Where the app reaches the API. On a phone, use your computer's LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
