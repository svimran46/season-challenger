# API
PORT=3000
# Leave unset to keep everything in memory for development. Required in production.
# DATABASE_URL=postgres://season:season@localhost:5432/season_challenger
# How often the worker syncs the feed, in seconds.
WORKER_SECONDS=60
REDIS_URL=redis://localhost:6379
# Football data: "fake" (offline fictional league) or "api-football" (API-Football, api-sports.io).
# Without API_FOOTBALL_KEY the API falls back to the fake league (production refuses to start).
FOOTBALL_FEED=fake
# API_FOOTBALL_KEY=
# League id (39 = Premier League) and season by starting year (2026 = 2026/27).
API_FOOTBALL_LEAGUE=39
API_FOOTBALL_SEASON=2026
# "dev" accepts an x-user-id header as sign-in (development only). Production refuses it.
AUTH_MODE=dev
# Key for hashing ID document numbers; set a long random value outside development.
ID_HASH_SECRET=dev-only-secret

# Mobile (Expo reads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_API_URL=http://localhost:3000
# Stand-in player id until phone sign-in exists; give each test device its own.
EXPO_PUBLIC_DEV_PLAYER_ID=dev-player
