# API
PORT=3000
DATABASE_URL=postgres://season:season@localhost:5432/season_challenger
REDIS_URL=redis://localhost:6379
# Which football data source the API uses: "fake" (offline, deterministic) or a real provider later.
FOOTBALL_FEED=fake

# Mobile (Expo reads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_API_URL=http://localhost:3000
